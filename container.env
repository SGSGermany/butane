REGISTRY="${REGISTRY:-ghcr.io}"
OWNER="${OWNER:-sgsgermany}"
IMAGE="${IMAGE:-butane}"
TAGS="${TAGS:-latest}"

VERSION="${VERSION:-}"

BUTANE_GIT_REPO="https://github.com/coreos/butane.git"
BUTANE_GIT_REF="refs/heads/main"
[ -z "$VERSION" ] || BUTANE_GIT_REF="refs/tags/v$VERSION"

MBUTANE_GIT_REPO="https://github.com/PhrozenByte/mbutane.git"
MBUTANE_GIT_REF="refs/heads/main"

BASE_IMAGE="ghcr.io/sgsgermany/alpine:v3.23"
